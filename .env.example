# Tiny Courtroom environment configuration
#
# Copy this file to `.env` and adjust the values for your local machine.
# All variables are optional. When omitted, the app uses sensible local
# defaults and can run without an external LLM provider.

# ---------------------------------------------------------------------------
# Optional LLM configuration
# ---------------------------------------------------------------------------

# Provider to use for advocate and judge generation.
# Supported values:
#   local            - deterministic built-in generator, no API key required
#   openai           - OpenAI API
#   anthropic        - Anthropic API
#   openai_compatible - any OpenAI-compatible endpoint
TINY_COURTROOM_LLM_PROVIDER=local

# API key for remote LLM providers.
# Leave blank when using the local deterministic provider.
TINY_COURTROOM_LLM_API_KEY=

# Model name passed to the selected provider.
# Examples:
#   gpt-4o-mini
#   claude-3-5-haiku-20241022
#   llama-3.1-8b-instruct
TINY_COURTROOM_LLM_MODEL=gpt-4o-mini

# Optional base URL for OpenAI-compatible endpoints.
# Uncomment and set this when using a self-hosted or proxy endpoint.
# TINY_COURTROOM_LLM_BASE_URL=https://api.openai.com/v1
# TINY_COURTROOM_LLM_BASE_URL=http://localhost:11434/v1

# Sampling and request limits.
TINY_COURTROOM_LLM_TEMPERATURE=0.2
TINY_COURTROOM_LLM_MAX_TOKENS=700
TINY_COURTROOM_LLM_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# Directory used for JSON-backed storage of documents, debates, and verdicts.
TINY_COURTROOM_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

TINY_COURTROOM_HOST=127.0.0.1
TINY_COURTROOM_PORT=8000
TINY_COURTROOM_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Retrieval and chunking
# ---------------------------------------------------------------------------

# Number of source lines in each line-aware chunk.
TINY_COURTROOM_CHUNK_LINES=12

# Number of retrieved snippets supplied to each advocate.
TINY_COURTROOM_RETRIEVAL_TOP_K=6

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------

# Maximum uploaded file size in bytes (1 MiB).
TINY_COURTROOM_MAX_UPLOAD_BYTES=1048576